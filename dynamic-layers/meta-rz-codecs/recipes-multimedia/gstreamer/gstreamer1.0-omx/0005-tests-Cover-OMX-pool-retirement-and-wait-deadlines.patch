+)
+test('omx_retirement', retirement_test, timeout : 30)
+
+if cc.has_link_argument('-Wl,--gc-sections')
+  deadline_test = executable('omx_wait_deadlines',
+    'generic/wait-deadlines.c',
+    include_directories : [include_directories('../../omx'), omx_inc],
+    c_args : ['-ffunction-sections', '-fdata-sections'],
+    link_args : ['-Wl,--gc-sections'],
+    dependencies : [gst_dep, gstvideo_dep, gstallocators_dep, gmodule_dep],
+  )
+  test('omx_wait_deadlines', deadline_test, timeout : 30)
+endif
