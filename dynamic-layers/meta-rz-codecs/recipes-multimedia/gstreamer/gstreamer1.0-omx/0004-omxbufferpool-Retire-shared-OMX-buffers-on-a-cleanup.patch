 omx/gstomx.h           |   3 ++
 omx/gstomxallocator.c  | 107 +++++++++++++++++++++----------------
 omx/gstomxallocator.h  |   6 ++-
 omx/gstomxbufferpool.c | 116 ++++++++++++++++++++++++++++++++++-------
 omx/gstomxbufferpool.h |   4 +-
 omx/gstomxvideodec.c   |   6 ++-
 7 files changed, 251 insertions(+), 78 deletions(-)

