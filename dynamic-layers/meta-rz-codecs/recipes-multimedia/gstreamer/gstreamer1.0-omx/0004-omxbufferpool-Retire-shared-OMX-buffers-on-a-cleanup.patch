@@ -2579,7 +2581,12 @@ gst_omx_port_allocate_buffers_unlocked (GstOMXPort * port,
   gint i;
   const GList *l;
 
-  g_assert (!port->buffers || port->buffers->len == 0);
+  if (g_atomic_int_get (&port->retiring_pool) || (port->buffers
+          && port->buffers->len != 0)) {
+    GST_WARNING_OBJECT (port->comp->parent,
+        "Port %u still has buffers from its previous pool", port->index);
+    return OMX_ErrorIncorrectStateOperation;
+  }
 
   g_return_val_if_fail (!port->tunneled, OMX_ErrorBadParameter);
 
