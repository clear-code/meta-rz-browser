 /* NOTE: Must be called while holding comp->lock, uses comp->messages_lock */
 static OMX_ERRORTYPE
-gst_omx_port_deallocate_buffers_unlocked (GstOMXPort * port)
+gst_omx_port_deallocate_buffers_unlocked (GstOMXPort * port, gboolean retiring)
 {
   GstOMXComponent *comp;
   OMX_ERRORTYPE err = OMX_ErrorNone;
@@ -2895,6 +2902,12 @@ gst_omx_port_deallocate_buffers_unlocked (GstOMXPort * port)
 
   comp = port->comp;
 
+  if (g_atomic_int_get (&port->retiring_pool) && !retiring) {
+    GST_DEBUG_OBJECT (comp->parent,
+        "Port %u buffers are owned by a retiring pool", port->index);
+    return OMX_ErrorIncorrectStateOperation;
+  }
+
   GST_INFO_OBJECT (comp->parent, "Deallocating buffers of %s port %u",
       comp->name, port->index);
 
@@ -2973,8 +2986,63 @@ gst_omx_port_deallocate_buffers (GstOMXPort * port)
 
   g_return_val_if_fail (port != NULL, OMX_ErrorUndefined);
 
+  if (g_atomic_int_get (&port->retiring_pool))
+    return OMX_ErrorIncorrectStateOperation;
+
+  g_mutex_lock (&port->comp->lock);
+  err = gst_omx_port_deallocate_buffers_unlocked (port, FALSE);
+  g_mutex_unlock (&port->comp->lock);
+
+  return err;
+}
+
+void
+gst_omx_port_begin_retirement (GstOMXPort *port)
+{
+  /* Do not wait for comp->lock here: an OMX API holding it may be stuck. */
+  g_atomic_int_set (&port->retiring_pool, TRUE);
+  gst_omx_component_send_message (port->comp, NULL);
+}
+
+/* Only the cleanup worker may release buffers reserved by a retired pool. */
+OMX_ERRORTYPE
+gst_omx_port_finish_retirement (GstOMXPort *port)
+{
+  OMX_ERRORTYPE err;
+  guint i;
+  gint64 deadline = gst_omx_wait_deadline (5 * GST_SECOND);
+  gboolean flushing = FALSE;
+
   g_mutex_lock (&port->comp->lock);
-  err = gst_omx_port_deallocate_buffers_unlocked (port);
+retry:
+  gst_omx_component_handle_messages (port->comp);
+  if (port->buffers) {
+    for (i = 0; i < port->buffers->len; i++) {
+      GstOMXBuffer *buf = g_ptr_array_index (port->buffers, i);
+
+      if (buf->used) {
+        if (!flushing) {
+          /* A downstream pool can be stopped before the decoder transitions
+           * to Idle. Reclaim OMX-owned buffers on this worker, not on the
+           * downstream thread. */
+          g_mutex_unlock (&port->comp->lock);
+          gst_omx_port_set_flushing (port, 5 * GST_SECOND, TRUE);
+          g_mutex_lock (&port->comp->lock);
+          flushing = TRUE;
+          goto retry;
+        }
+        if (gst_omx_component_wait_message_until (port->comp, deadline))
+          goto retry;
+        g_mutex_unlock (&port->comp->lock);
+        return OMX_ErrorTimeout;
+      }
+    }
+  }
+  err = gst_omx_port_deallocate_buffers_unlocked (port, TRUE);
+  if (err == OMX_ErrorNone) {
+    port->using_pool = FALSE;
+    g_atomic_int_set (&port->retiring_pool, FALSE);
+  }
   g_mutex_unlock (&port->comp->lock);
 
   return err;
@@ -3182,7 +3250,8 @@ gst_omx_port_populate_unlocked (GstOMXPort * port)
 
   gst_omx_component_handle_messages (comp);
 
-  if (port->flushing || port->disabled_pending || !port->port_def.bEnabled) {
+  if (port->flushing || g_atomic_int_get (&port->retiring_pool)
+      || port->disabled_pending || !port->port_def.bEnabled) {
     GST_DEBUG_OBJECT (comp->parent, "%s port %u is flushing or disabled",
         comp->name, port->index);
     err = OMX_ErrorIncorrectStateOperation;
