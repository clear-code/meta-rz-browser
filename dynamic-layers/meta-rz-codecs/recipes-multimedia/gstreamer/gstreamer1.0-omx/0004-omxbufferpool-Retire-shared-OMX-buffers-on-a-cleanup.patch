+/* Called only by the pool's cleanup worker, never by a memory dispose callback.
+ * The pool keeps the foreign GstBuffers alive until this has completed. */
+void
+gst_omx_allocator_finish_retirement (GstOMXAllocator * allocator)
+{
+  g_mutex_lock (&allocator->lock);
+  GST_DEBUG_OBJECT (allocator, "Retirement waiting for %u outstanding memories",
+      allocator->n_outstanding);
+  while (allocator->n_outstanding != 0)
+    g_cond_wait (&allocator->released, &allocator->lock);
+  gst_omx_allocator_dealloc (allocator);
+  GST_DEBUG_OBJECT (allocator, "Retired allocator memories released");
   g_mutex_unlock (&allocator->lock);
 }
 
 static inline void
 dec_outstanding (GstOMXAllocator * allocator)
 {
-  if (g_atomic_int_dec_and_test (&allocator->n_outstanding)) {
-    /* keep a ref to the allocator because _dealloc() will free
-     * all the memories and the memories might be the only thing holding
-     * a reference to the allocator; we need to keep it alive until the
-     * end of this function call */
-    g_object_ref (allocator);
-
-    /* take the lock so that _set_active() is not run concurrently */
-    g_mutex_lock (&allocator->lock);
-
-    /* now that we have the lock, check if we have been de-activated with
-     * outstanding buffers */
-    if (!allocator->active)
+  /* Take the reference and lock BEFORE decrementing. Otherwise retirement can
+   * observe zero and destroy the memory/allocator before we take the lock. */
+  gst_object_ref (allocator);
+  g_mutex_lock (&allocator->lock);
+  if (--allocator->n_outstanding == 0) {
+    if (!allocator->active && !allocator->retiring)
       gst_omx_allocator_dealloc (allocator);
-
-    g_mutex_unlock (&allocator->lock);
-    g_object_unref (allocator);
+    g_cond_broadcast (&allocator->released);
   }
+  g_mutex_unlock (&allocator->lock);
+  gst_object_unref (allocator);
 }
 
